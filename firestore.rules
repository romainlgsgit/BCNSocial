rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Modération ────────────────────────────────────────────────────────────
    // `request.time` est l'horloge du SERVEUR : c'est ce qui rend un bannissement
    // temporaire infalsifiable. Changer la date du téléphone n'a aucun effet ici.
    function adminEmail() {
      return 'legrosromain27@gmail.com';
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == adminEmail();
    }
    function banDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isBanned() {
      return request.auth != null
        && (
          banDoc().get('banPermanent', false) == true
          || banDoc().get('bannedUntil', null) != null
             && banDoc().bannedUntil > request.time
        );
    }
    // Un compte actif = connecté et non banni. L'admin n'est jamais bloqué.
    function activeUser() {
      return request.auth != null && (isAdmin() || !isBanned());
    }

    // Identités bannies définitivement : lecture PUBLIQUE car vérifiée avant
    // connexion (comme /usernames) ; écriture réservée à l'admin.
    match /bannedIdentities/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Posts et commentaires : lecture publique, écriture réservée aux comptes non
    // bannis. La suppression reste ouverte à l'admin (modération).
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if activeUser();
      allow delete: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if activeUser();
        allow delete: if request.auth != null;
      }
    }

    // Profils utilisateurs
    //
    // L'écriture croisée reste ouverte (compteurs d'abonnés, gains des mini-jeux,
    // premium écrivent sur le doc d'un AUTRE utilisateur), mais les champs de
    // bannissement sont réservés à l'admin : sans ça, un banni n'aurait qu'à
    // remettre `bannedUntil` à null pour se libérer lui-même.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAdmin() || !touchesBanFields());
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    function touchesBanFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['banPermanent', 'bannedUntil', 'banReason', 'bannedAt']);
    }

    // Mapping pseudo → email pour la connexion/reset par pseudo (lecture publique
    // nécessaire : le client n'est pas encore authentifié à ce stade). Immuable une
    // fois créé pour empêcher le vol de pseudo.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      // Le propriétaire peut libérer SON pseudo (suppression de compte). Sans ça, le
      // pseudo restait réservé à vie et « déjà utilisé » après suppression du compte.
      // La réservation stocke { email, uid } → on vérifie l'uid.
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Achats de pièces (boutique) — doc ID = identifiant de transaction du store.
    //
    // C'est le registre qui rend le crédit IDEMPOTENT : le client n'incrémente le
    // solde que si le doc n'existe pas encore, dans la même transaction. Interdire
    // update/delete est donc essentiel — pouvoir effacer une entrée reviendrait à
    // pouvoir se recréditer indéfiniment le même achat.
    //
    // La lecture reste ouverte aux comptes connectés : le crédit doit d'abord LIRE
    // un doc qui n'existe pas encore, et une règle basée sur `resource.data` échoue
    // sur un document absent — ce qui casserait tout achat. L'ID étant l'identifiant
    // de transaction Apple, il n'y a rien à énumérer.
    match /coinPurchases/{transactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    // Config app (cotes, etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Paris / pronostics
    match /bets/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Score live partagé entre tous les users
    match /liveMatch/{docId} {
      allow read, write: if true;
    }

    // Compositions validées par l'admin : lecture publique, écriture admin uniquement
    match /lineups/{matchId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'legrosromain27@gmail.com';
    }

    // Votes des utilisateurs : lecture par tout user connecté (pour profils publics), écriture uniquement par le propriétaire
    match /userVotes/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fiches joueurs (effectif) : lecture publique, écriture admin uniquement
    match /players/{playerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'legrosromain27@gmail.com';
    }

    // Stats agrégées des joueurs : lecture publique, écriture par tout user connecté (transactions)
    match /playerStats/{playerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Stats agrégées des matchs : lecture publique, écriture par tout user connecté (transactions)
    match /matchStats/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quiz quotidien : chacun ne lit et n'écrit QUE son propre résultat. Sans cette
    // règle, la lecture échoue → `hasPlayedToday` reste false et le quiz est rejouable
    // en boucle (points et pièces farmables à l'infini).
    match /quizResults/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Résultats de match utilisés pour régler les paris
    match /matchResults/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'legrosromain27@gmail.com';
    }

    // Abonnements : lecture par user connecté, création/suppression par le followerId
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Abonnements notifications : lecture/écriture par l'abonné, lecture par la cible (pour envoyer les notifs)
    match /notifSubscriptions/{subId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.subscriberId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.subscriberId;
    }

    // Blocages : chacun peut lire/créer/supprimer ses propres blocages
    match /blocks/{blockId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.blockerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.blockerId;
    }

    // File d'attente du mini-jeu : doc ID = uid. Le matching consomme (marque "claimed")
    // le doc de l'AUTRE joueur en attente, donc pas restreint au seul propriétaire —
    // même modèle de confiance ouvert que users/{userId} ou liveMatch/{docId}.
    match /gameQueue/{userId} {
      allow read, write: if request.auth != null;
    }

    // Invitations au mini-jeu : doc ID = `${toId}_${fromId}`, lecture par les 2 parties,
    // création par l'inviteur, suppression par l'une ou l'autre partie (accept/decline)
    match /gameInvites/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromId;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromId || request.auth.uid == resource.data.toId);
    }

    // Parties du mini-jeu : lecture/écriture par les 2 participants uniquement
    match /games/{gameId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants;
    }

  }
}
